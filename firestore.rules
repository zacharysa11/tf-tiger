rules_version = '2';
// TF Tiger A1/4 Board: open board. Anyone with the link can read and edit
// the board's five collections; nothing else in the database is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{id} {
      allow read: if col in ['people', 'missions', 'equip', 'resupply', 'log'];
      allow write: if col in ['people', 'missions', 'equip', 'resupply', 'log'];
    }
  }
}

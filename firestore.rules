rules_version = '2';
// TF Tiger A1/4 Board: any signed-in login can read; only the editor logins can write.
// Keep this list in step with EDITORS in config.js.
service cloud.firestore {
  match /databases/{database}/documents {
    function isEditor() {
      return request.auth != null
        && request.auth.token.email.lower() in [
          'paste_editor_email'
        ];
    }
    match /{col}/{id} {
      allow read: if request.auth != null
        && col in ['people', 'missions', 'equip', 'resupply', 'log'];
      allow write: if isEditor()
        && col in ['people', 'missions', 'equip', 'resupply', 'log'];
    }
  }
}

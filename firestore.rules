rules_version = '2';
// TF Tiger board: open board. Anyone with the link can read and edit
// the board's collections; nothing else in the database is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{id} {
      allow read, write: if col in ['people', 'missions', 'equip', 'resupply', 'log', 'intel', 'pirs', 'comms'];
    }
  }
}

rules_version = '2';
// TF Tiger board: locked. Only someone signed in with the board password
// can read or edit the board's collections; nothing else is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{col}/{id} {
      allow read, write: if request.auth != null
        && col in ['people', 'missions', 'equip', 'resupply', 'log', 'intel', 'pirs', 'comms'];
    }
  }
}
